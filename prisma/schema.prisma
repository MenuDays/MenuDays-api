generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auditoria_logs {
  id            BigInt    @id @default(autoincrement())
  usuario_id    BigInt?
  accion        String    @db.VarChar(100)
  entidad_tipo  String    @db.VarChar(50)
  entidad_id    BigInt?
  datos_previos Json?
  datos_nuevos  Json?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  usuarios      usuarios? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entidad_tipo, entidad_id], map: "ix_auditoria_entidad")
  @@index([usuario_id], map: "ix_auditoria_usuario")
}

model auth_tokens {
  id         BigInt          @id @default(autoincrement())
  usuario_id BigInt
  tipo       auth_token_tipo
  token_hash String          @unique(map: "ux_auth_tokens_hash")
  expira_en  DateTime        @db.Timestamptz(6)
  usado_en   DateTime?       @db.Timestamptz(6)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  usuarios   usuarios        @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id, tipo], map: "ix_auth_tokens_usuario")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model categorias {
  id                     BigInt                  @id @default(autoincrement())
  nombre                 String                  @unique @db.VarChar(100)
  icono_id               BigInt?
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  iconos                 iconos?                 @relation(fields: [icono_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activo                 Boolean                 @default(true)
  platos                 platos[]
  menus_del_dia          menus_del_dia[]
  promociones            promociones[]
  restaurante_categorias restaurante_categoria[]

  @@map("categorias")
}

model favoritos {
  id             BigInt       @id @default(autoincrement())
  usuario_id     BigInt
  restaurante_id BigInt
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  restaurantes   restaurantes @relation(fields: [restaurante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, restaurante_id])
  @@index([restaurante_id], map: "ix_favoritos_restaurante")
  @@index([usuario_id], map: "ix_favoritos_usuario")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model galeria_imagenes {
  id             BigInt       @id @default(autoincrement())
  restaurante_id BigInt
  url            String
  es_portada     Boolean      @default(false)
  orden          Int          @default(0)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  restaurantes   restaurantes @relation(fields: [restaurante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([restaurante_id], map: "ix_galeria_restaurante")
}

model iconos {
  id         BigInt       @id @default(autoincrement())
  nombre     String       @unique @db.VarChar(80)
  url        String
  categorias categorias[]

  @@map("iconos")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model menus_del_dia {
  id               BigInt             @id @default(autoincrement())
  restaurante_id   BigInt
  nombre           String             @db.VarChar(150)
  categoria_id     BigInt?
  descripcion      String?
  precio           Decimal            @db.Decimal(10, 2)
  foto_url         String?
  fecha_inicio     DateTime           @db.Date
  fecha_fin        DateTime           @db.Date
  estado           estado_publicacion @default(programado)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  coleccion_id     BigInt?
  // Menú "compuesto": hasta 5 platos con nombre libre, uno por cada tipo
  // fijo (Entrada/Sopa/Plato Fuerte/Jugo/Postre). Todos opcionales -- no
  // todos los restaurantes completan los 5. Reemplaza a coleccion_id
  // como forma de "tipar" un menú: un mismo menú puede tener presencia
  // en varios tipos a la vez (ej. incluye entrada Y postre), algo que
  // coleccion_id (1 menú = 1 colección) no podía representar.
  // Cada tipo admite VARIOS nombres (ej. el restaurante ofrece dos
  // entradas distintas ese día) -- por eso array, no un string suelto.
  // El comensal ve cada uno como un checkbox dentro de su tipo.
  componente_entrada     String[] @default([])
  componente_sopa        String[] @default([])
  componente_plato_fuerte String[] @default([])
  componente_jugo        String[] @default([])
  componente_postre      String[] @default([])
  // Palabras clave del menú (chips en el front). Pensado para
  // búsqueda/filtro futuro -- por eso array nativo, no un string.
  tags             String[]           @default([])
  // "hoy" = vigente solo el día de creación; "fecha" = fecha_inicio/
  // fecha_fin tal cual (comportamiento de siempre); "semanal" = se
  // repite en los días de dias_semana dentro de la ventana
  // fecha_inicio/fecha_fin (ver filtro de vigencia en PublicMenuService).
  tipo_programacion tipo_programacion_menu @default(fecha)
  // 1=Lunes ... 7=Domingo (mismo criterio que restaurante_horarios.dia_semana),
  // solo se usa cuando tipo_programacion = semanal.
  dias_semana      Int[]              @default([])
  restaurantes     restaurantes       @relation(fields: [restaurante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categorias       categorias?        @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_colecciones menu_colecciones?  @relation(fields: [coleccion_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pedidos          pedidos[]

  @@index([restaurante_id], map: "ix_menus_restaurante")
  @@index([categoria_id], map: "ix_menus_categoria")
  @@index([coleccion_id], map: "ix_menus_coleccion")
  @@index([fecha_inicio, fecha_fin], map: "ix_menus_vigencia")
}

// Colecciones de Menús: agrupan exclusivamente menús del día dentro de un
// mismo restaurante (ej. "Entradas", "Sopas", "Menú Infantil", "Postres").
// Concepto independiente de `categorias` (taxonomía global de cocina que
// usan platos/menús/promociones) -- no se relaciona con esa tabla para
// evitar mezclar ambos sistemas.
model menu_colecciones {
  id             BigInt          @id @default(autoincrement())
  restaurante_id BigInt
  nombre         String          @db.VarChar(100)
  orden          Int             @default(0)
  activo         Boolean         @default(true)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  restaurantes   restaurantes    @relation(fields: [restaurante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menus_del_dia  menus_del_dia[]

  @@unique([restaurante_id, nombre])
  @@index([restaurante_id], map: "ix_menu_colecciones_restaurante")
}

model motivos_reporte {
  id       BigInt     @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(150)
  reportes reportes[]
}

model notificaciones {
  id              BigInt            @id @default(autoincrement())
  usuario_id      BigInt
  tipo            notificacion_tipo
  titulo          String            @db.VarChar(150)
  mensaje         String
  leida           Boolean           @default(false)
  referencia_tipo String?           @db.VarChar(50)
  referencia_id   BigInt?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  usuarios        usuarios          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id, leida], map: "ix_notificaciones_usuario")
}

model pedido_historial_estados {
  id              BigInt         @id @default(autoincrement())
  pedido_id       BigInt
  estado_anterior estado_pedido?
  estado_nuevo    estado_pedido
  modificado_por  BigInt?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  usuarios        usuarios?      @relation(fields: [modificado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidos         pedidos        @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pedido_id], map: "ix_historial_pedido")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model pedidos {
  id                       BigInt                     @id @default(autoincrement())
  codigo_unico             String                     @unique(map: "ux_pedidos_codigo") @default(dbgenerated("upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 8))")) @db.VarChar(12)
  usuario_id               BigInt
  restaurante_id           BigInt
  tipo_item                item_pedido_tipo
  menu_dia_id              BigInt?
  plato_id                 BigInt?
  promocion_id             BigInt?
  observaciones            String?
  precio_total             Decimal                    @db.Decimal(10, 2)
  metodo_entrega           metodo_entrega             @default(RETIRO_EN_LOCAL)
  estado                   estado_pedido              @default(pendiente)
  mensaje_whatsapp         String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  pedido_historial_estados pedido_historial_estados[]
  menus_del_dia            menus_del_dia?             @relation(fields: [menu_dia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  platos                   platos?                    @relation(fields: [plato_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promociones              promociones?               @relation(fields: [promocion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurantes             restaurantes               @relation(fields: [restaurante_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios                 usuarios                   @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resenas                  resenas?

  @@index([estado], map: "ix_pedidos_estado")
  @@index([restaurante_id, estado], map: "ix_pedidos_restaurante")
  @@index([usuario_id], map: "ix_pedidos_usuario")
}

model plato_imagenes {
  id       BigInt @id @default(autoincrement())
  plato_id BigInt
  url      String
  orden    Int    @default(0)
  platos   platos @relation(fields: [plato_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plato_id], map: "ix_plato_imagenes_plato")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model platos {
  id             BigInt                @id @default(autoincrement())
  restaurante_id BigInt
  categoria_id   BigInt
  nombre         String                @db.VarChar(150)
  descripcion    String?
  precio         Decimal               @db.Decimal(10, 2)
  estado         estado_disponibilidad @default(disponible)
  activo         Boolean               @default(true)
  orden          Int                   @default(0)
  // El restaurante puede marcar un plato como "destacado" (aparece en
  // el carrusel de Platos Destacados del comensal) y/o "en oferta" (con
  // un precio rebajado opcional -- si no se manda precio_oferta, se
  // muestra como oferta sin precio tachado, solo el badge). Ambos son
  // independientes entre sí y de estado/activo.
  destacado      Boolean               @default(false)
  en_oferta      Boolean               @default(false)
  precio_oferta  Decimal?              @db.Decimal(10, 2)
  created_at     DateTime              @default(now()) @db.Timestamptz(6)
  updated_at     DateTime              @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?             @db.Timestamptz(6)
  pedidos        pedidos[]
  plato_imagenes plato_imagenes[]
  categorias     categorias            @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  restaurantes   restaurantes          @relation(fields: [restaurante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([categoria_id], map: "ix_platos_categoria")
  @@index([restaurante_id], map: "ix_platos_restaurante")
  @@index([destacado], map: "ix_platos_destacado")
  @@index([en_oferta], map: "ix_platos_en_oferta")
}

