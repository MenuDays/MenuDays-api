  password_hash                                                          String
  rol                                                                    rol_usuario                @default(comensal)
  nombre                                                                 String                     @db.VarChar(100)
  apellido                                                               String                     @db.VarChar(100)
  foto_perfil_url                                                        String?
  ubicacion_lat                                                          Decimal?                   @db.Decimal(9, 6)
  ubicacion_lng                                                          Decimal?                   @db.Decimal(9, 6)
  radio_busqueda_km                                                      Decimal                    @default(5) @db.Decimal(5, 2)
  email_verificado                                                       Boolean                    @default(false)
  estado                                                                 estado_cuenta_usuario      @default(activo)
  created_at                                                             DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                                             DateTime                   @default(now()) @db.Timestamptz(6)
  deleted_at                                                             DateTime?                  @db.Timestamptz(6)
  ciudad_id                                                              BigInt?
  phoneNumber                                                            String?                    @unique @db.VarChar(20)
  auditoria_logs                                                         auditoria_logs[]
  auth_tokens                                                            auth_tokens[]
  favoritos                                                              favoritos[]
  notificaciones                                                         notificaciones[]
  pedido_historial_estados                                               pedido_historial_estados[]
  pedidos                                                                pedidos[]
  reportes_reportes_revisado_porTousuarios                               reportes[]                 @relation("reportes_revisado_porTousuarios")
  reportes_reportes_usuario_idTousuarios                                 reportes[]                 @relation("reportes_usuario_idTousuarios")
  resenas                                                                resenas[]
  restaurantes                                                           restaurantes?
  solicitudes_restaurante_solicitudes_restaurante_revisado_porTousuarios solicitudes_restaurante[]  @relation("solicitudes_restaurante_revisado_porTousuarios")
  solicitudes_restaurante_solicitudes_restaurante_usuario_idTousuarios   solicitudes_restaurante[]  @relation("solicitudes_restaurante_usuario_idTousuarios")
  ciudad                                                                 ciudades?                  @relation(fields: [ciudad_id], references: [id])

  @@index([rol], map: "ix_usuarios_rol")
  @@index([ubicacion_lat, ubicacion_lng], map: "ix_usuarios_ubicacion")
  @@index([ciudad_id], map: "ix_usuarios_ciudad")
}

model provincias {
  id                      BigInt                    @id @default(autoincrement())
  nombre                  String                    @unique @db.VarChar(100)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  ciudades                ciudades[]
  solicitudes_restaurante solicitudes_restaurante[]

  @@index([nombre], map: "ix_provincias_nombre")
  @@map("provincias")
}

model ciudades {
  id                      BigInt                    @id @default(autoincrement())
  nombre                  String                    @db.VarChar(100)
  provincia_id            BigInt
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  latitud                 Decimal?                  @db.Decimal(9, 6)
  longitud                Decimal?                  @db.Decimal(9, 6)
  provincia               provincias                @relation(fields: [provincia_id], references: [id])
  restaurantes            restaurantes[]
  solicitudes_restaurante solicitudes_restaurante[]
  usuarios                usuarios[]

  @@unique([nombre, provincia_id], map: "ux_ciudades_nombre_provincia")
  @@index([nombre], map: "ix_ciudades_nombre")
  @@index([provincia_id])
  @@map("ciudades")
}

